{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofnet.local/schemas/proofnet_boundary_graph_schema_v0_7_2.json",
  "title": "ProofNet Boundary-Lens cumulative graph snapshot v0.7.2",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "quality_tier",
    "theorem_id",
    "variant_id",
    "step_index",
    "phase",
    "frontier",
    "rho",
    "boundary_capsules",
    "nodes",
    "edges",
    "boundary_hash_canonical",
    "cumulative_graph_hash",
    "provenance_channel"
  ],
  "properties": {
    "schema_version": {"const": "0.7.2"},
    "record_type": {"const": "boundary_graph_snapshot"},
    "quality_tier": {"type": "string"},
    "theorem_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "step_index": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["before", "after", "failure_before", "final"]},
    "frontier": {"type": "array", "items": {"type": "string"}},
    "rho": {"type": "object", "additionalProperties": {"type": "string"}},
    "boundary_capsules": {"type": "array", "items": {"type": "object"}},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "type"]}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["source", "target", "type", "verification"]}},
    "boundary_hash_raw": {"type": "string", "pattern": "^sha256:"},
    "boundary_hash_canonical": {"type": "string", "pattern": "^sha256:"},
    "cumulative_graph_hash": {"type": "string", "pattern": "^sha256:"},
    "feature_channel": {"type": "object"},
    "identity_channel": {"type": "object"},
    "provenance_channel": {"type": "object"}
  },
  "additionalProperties": true
}
